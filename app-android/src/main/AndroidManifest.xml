<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      ⚠️ 为 minSdk 24（Android 7.0）强制放行的库清单。

      1. `com.mocharealm.accompanist.lyrics.ui` —— 歌词滚动/卡拉OK 组件。
         它在自己的 AAR 清单里写了 `minSdkVersion="29"`，manifest merger 因此报
         "uses-sdk:minSdkVersion 24 cannot be smaller than version 29 declared in library"。

         这个 29 是**作者随手写的下限，不是真实依赖**。逐类 javap 核对过（2026-10-05）：
           - 它对 `android.*` 的引用只有 `android.os.Build` / `Build$VERSION`，
             用法仅是在 `SDK_INT >= 34 / >= 36` 时往集合里多塞几个 Unicode 区块
             （CJK 扩展 E/F/G/H、Arabic Ext B）—— 低版本只是少认几个生僻字区块；
           - 对 `java.*` 的引用只有 `java.lang.*` / `java.util.*`，没有 java.time / java.nio.file；
           - 其余全是 androidx.compose。
         ⇒ 强制放行在 API 24/25 上不会崩，最坏情况是极生僻字被当成非 CJK。

      2. `com.xzakota.hyper.notification.focus`（HyperOS 焦点通知 / 超级岛，AAR 声明 minSdk 27）
         —— 已核对：整包的 `android.*` 引用只有 12 个类型
         （Notification / Notification$Builder / NotificationManager / Context /
          ContentResolver / Uri / Bundle / Parcelable / RemoteViews / Settings$System /
          SuppressLint），**全部 API ≤ 24 就存在**；
         调用的**方法**只有 `Notification$Builder.addExtras`（API 20）、`build()`、
         `NotificationManager.notify`、`ContentResolver.call`、`Settings$System.getInt`
         —— 没有一处是 26/27+ 才有的 API。它声明 27 是因为自己面向 HyperOS，
         而 HyperOS 本身 ≥ 29，与本库能否在 24/25 上加载无关。

      3. `com.hchen.superlyricapi`（SuperLyric 发布者契约，AAR 声明 minSdk 26）
         —— 已核对：`android.*` 引用为 Bundle / Parcel / Parcelable / IBinder / Binder /
         IInterface / RemoteException / ServiceManager / Log / MediaMetadata / PlaybackState
         —— 全部 API ≤ 24 就存在（`ServiceManager` 是隐藏类，但自 API 1 就存在，只是不在公开
         SDK 里）。声明 26 同样是作者随手写的。

      ⚠️ 换这三个库的版本时**必须重新核对**：拿新 AAR 的 classes.jar 跑一遍
      `javap` / 常量池扫描，确认没有新增 API > 24 的平台引用，否则这些覆盖会变成运行时崩溃。
      ⚠️ 别把它当成「所有库都能这么放行」的先例 —— 只有核对过字节码的库才允许。
    -->
    <uses-sdk
        tools:overrideLibrary="com.mocharealm.accompanist.lyrics.ui,com.xzakota.hyper.notification.focus,com.hchen.superlyricapi" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 激进保活（设置 → 连接与集成 → 激进保活）需要：持 Wi-Fi 高性能锁，熄屏后不让 Wi-Fi
         进入省电模式（否则组播发现包会被丢弃 ⇒「手机在旁边却搜不到」）。
         两条都是 normal 权限，系统自动授予，不会弹窗。 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- 熄屏后持 CPU/WiFi 唤醒锁，防止在线流断流（配合 ExoPlayer.setWakeMode 使用） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 小米超级岛歌词：由 specialUse 类型的前台服务承载焦点通知（见下方 service 声明）。
         这是 normal 权限，系统自动授予，不会弹窗。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 16 实时活动（Live Update）：`setRequestPromotedOngoing` 需要它。
         normal 权限，自动授予。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Shizuku：超级岛歌词靠它临时切断 com.xiaomi.xmsf 的网络（联网显示的关键）。
         这条权限由 `dev.rikka.shizuku:provider` 的清单声明，这里显式重复一次只为可读性。 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- 「设置 → 播放与音质 → 电池优化白名单」需要：弹系统授权框申请豁免电池优化，
         熄屏后台播放的进程级保护（配合媒体前台服务使用） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!--
      Android 11（API 30）起的包可见性：不声明 `<queries>` 的话
      `getPackageInfo("moe.shizuku.privileged.api")` 会抛 NameNotFoundException，
      表现为「明明装了 Shizuku，设置页却说未安装」。见 core 的 ShizukuPermissions。
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".CPPlayerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="CPPlayer"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <service
            android:name=".PlaybackMediaSessionService"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          HyperOS 超级岛歌词的载体（见 core 的 XiaomiSuperIslandLyricService）。

          ⚠️ `specialUse` + `PROPERTY_SPECIAL_USE_FGS_SUBTYPE` 是硬要求：HyperOS 只把
          从**专用前台服务**里发出的焦点通知当作超级岛载荷，从播放进程直接 notify() 只会
          得到一条普通通知。

          ⚠️ 声明在 app-android 而不是 core：core 没有 AndroidManifest.xml
          （KMP library 插件下它的清单不参与合并），服务类本身在 core 里，靠全限定名引用。
        -->
        <service
            android:name="cp.player.core.lyricpush.XiaomiSuperIslandLyricService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Rendering the current lyric line inside the HyperOS Super Island while music plays" />
        </service>

        <!--
          Shizuku 的 keepalive UserService（见 core 的 ShizukuKeepAlive）。

          ⚠️ 官方 Shizuku README / demo **并不要求**声明 UserService 组件 —— 它由 Shizuku
          服务器在**独立进程**里按类名反射实例化（`UserServiceArgs.processNameSuffix`），
          与 Android 的 Service 组件无关。这里按移植指南 XIAOMI_SUPER_ISLAND_PORTING.md §2
          保留声明（指南把它列为必需项）；它是个空实现，声明与否都不影响绑定。
          若将来确认无必要，可以连同这条注释一起删掉。

          ⚠️ 类名不能被混淆：Shizuku 按全限定名加载它，见 proguard-rules.pro。
        -->
        <service
            android:name="cp.player.core.lyricpush.ShizukuKeepAliveService"
            android:exported="true" />

        <!--
          Shizuku 的 ContentProvider 通道（官方 README 明确要求，缺了就拿不到 binder）。

          ⚠️ `moe.shizuku.client.V3_SUPPORT` 这个 meta-data 与
          `moe.shizuku.manager.permission.API_V23` 权限都由
          `dev.rikka.shizuku:provider` 的 AAR 清单自动合并进来（2026-10-10 核对过 AAR 内的
          AndroidManifest.xml），这里**不要**再声明一遍 —— 重复声明同值虽然能合并，
          但一旦上游改了值就会变成 merger 冲突。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="CPPlayer"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          词幕（Lyricon）通过这几个 meta-data 发现「本应用可以作为它的歌词来源」。
          少了 `lyricon_module`，词幕里根本不会出现 CPPlayer 这个条目 ——
          表现为「代码全对但词幕收不到」，很难联想。见 core 的 LyriconBridge。
        -->
        <meta-data
            android:name="lyricon_module"
            android:value="true" />
        <meta-data
            android:name="lyricon_module_author"
            android:value="CPPlayer" />
        <meta-data
            android:name="lyricon_module_description"
            android:value="CPPlayer 歌词投放" />

        <!--
          SuperLyric 的 meta-data（`superlyricapi` / 版本号）由它的 AAR 清单自动合并，
          这里不需要重复声明。
        -->
    </application>

</manifest>
