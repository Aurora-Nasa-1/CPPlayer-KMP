# --- Build output ---------------------------------------------------------
.gradle/
build/
.kotlin/
.cxx/
.externalNativeBuild/
/captures

# Verification scratch dirs used to bypass a locked Gradle cache.
# The tag suffix is per-session (see AGENTS.md §3): the Groovy init script is
# <tag>.init.gradle, and it repoints buildDirectory at build-<tag>/ while
# --project-cache-dir=.gradle-<tag>. All three are scaffolding — delete them
# after use and never commit them.
# ⚠️ 三者都按**前缀/后缀**通配，而不是逐个列 tag 名 —— 各会话自取的 tag 五花八门
# （verify / v1 / authuiverify / bentohome / preview-xxx / settings …），列名字必然漏。
# 三条模式都不含中间斜杠 ⇒ 在任意目录层级都生效（build-foo/ 与 app/build-foo/ 都被忽略）。
.gradle-*/
build-*/
*.init.gradle

# --- IDE / editor --------------------------------------------------------
.idea/
*.iml
*.swp
.DS_Store

# --- Local configuration (never shared) ----------------------------------
local.properties

# --- Pinned JetBrains Runtime (downloaded on demand, ~90MB) --------------
# 换 JBR 打包用的运行时镜像。由 -Pcp.jbrDownload=true 或 CI 的下载 step 铺好，
# 不进版本库（体积 + 二进制不入库）。见 docs/JBR_PACKAGING.md。
.jbr/

# --- Build artifacts / diagnostics ---------------------------------------
*.so
*.hprof

# --- Read-only reference checkouts (not part of the Gradle build) --------
# Legacy Android project: a plain local checkout, excluded on purpose.
reference/cp-player-legacy/
# Upstream Flutter player used as a visual-design reference. Also a plain
# local checkout (~59 MB, its own .git) — referenced from docs/ only.
reference/Kazumi/
# Rust JNI module, also a plain local checkout with its own .git.
#
# 它此前是**索引里的一个 gitlink（mode 160000）但没有 .gitmodules** —— 仓库处于
# 「看起来是子模块、实际不是」的坏状态：裸克隆只会得到一个空目录，而
# `git submodule status` 直接报
#   fatal: no submodule mapping found in .gitmodules for path 'reference/netease-module-rust'
# 已从索引移除（工作区文件原样保留），与上面两个 reference 检出保持一致。
#
# ⚠️ 想把它变回**真正的**子模块，先满足这个前提：
#   该检出领先自己的 origin/main 2 个提交（含被 pin 的 067c150
#   "fix(jni): 导出符号前缀随宿主包名改为 cp.player.core"），这些提交**还没推上去**。
#   直接 git submodule add 会得到一个谁都拉不到的 gitlink —— 比现在更糟。
#   先把那两个提交推到 fork，再 git submodule add。
reference/netease-module-rust/

# --- AI tooling output (local only, regenerated on demand) ---------------
# Qoder's generated repo wiki + one-off git diff dumps. Kept on disk for
# local use, but they drift out of date with the code and duplicate
# docs/ARCHITECTURE.md, so they should not be version-controlled.
.qoder/

# WorkBuddy AI session memory / project notes. Local by nature.
.workbuddy-ai/

# 新版 WorkBuddy 工作目录（记忆 / 离屏渲染出图 / 临时件）。与 .workbuddy-ai 同理：
# 全是本机会话产物，不进版本库。
# ⚠️ 若将来这里出现需要共享的**项目级 skill**（.workbuddy/skills/），
# 要给它单独加一条 `!` 反规则放行，别整目录提交。
.workbuddy/
