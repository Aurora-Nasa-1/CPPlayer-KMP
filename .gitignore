# --- Build output ---------------------------------------------------------
.gradle/
build/
.kotlin/
.cxx/
.externalNativeBuild/
/captures

# Verification scratch dirs used to bypass a locked Gradle cache.
# The tag suffix is per-session (see AGENTS.md §3): the Groovy init script is
# cpplayer-verify-<tag>.init.gradle, and it repoints buildDirectory at
# build-<tag>/ while --project-cache-dir=.gradle-<tag>. All three are
# scaffolding — delete them after use and never commit them.
.gradle-verify*/
.gradle-v*/
build-verify*/
build-v*/
cpplayer-verify*.init.gradle

# --- IDE / editor --------------------------------------------------------
.idea/
*.iml
*.swp
.DS_Store

# --- Local configuration (never shared) ----------------------------------
local.properties

# --- Build artifacts / diagnostics ---------------------------------------
*.so
*.hprof

# --- Read-only reference checkouts (not part of the Gradle build) --------
# Legacy Android project: a plain local checkout, excluded on purpose.
reference/cp-player-legacy/
# Upstream Flutter player used as a visual-design reference. Also a plain
# local checkout (~59 MB, its own .git) — referenced from docs/ only.
reference/Kazumi/
# NOTE: reference/netease-module-rust is an unregistered submodule (gitlink
# in the index, no .gitmodules). It is deliberately NOT ignored here.

# --- AI tooling output (local only, regenerated on demand) ---------------
# Qoder's generated repo wiki + one-off git diff dumps. Kept on disk for
# local use, but they drift out of date with the code and duplicate
# docs/ARCHITECTURE.md, so they should not be version-controlled.
.qoder/

# WorkBuddy AI session memory / project notes. Local by nature.
.workbuddy-ai/
